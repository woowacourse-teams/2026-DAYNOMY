prometheus.exporter.unix "host" {
  include_exporter_metrics = true
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "environment"
    replacement  = sys.env("DAYNOMY_ENVIRONMENT")
  }

  rule {
    target_label = "service"
    replacement  = "host"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("DAYNOMY_INSTANCE")
  }
}

prometheus.exporter.postgres "database" {
  data_source_names = [sys.env("POSTGRES_EXPORTER_DSN")]
  enabled_collectors = [
    "database",
    "locks",
    "stat_activity_autovacuum",
    "stat_bgwriter",
    "stat_database",
    "stat_user_tables",
    "wal",
  ]
}

discovery.relabel "database" {
  targets = prometheus.exporter.postgres.database.targets

  rule {
    target_label = "environment"
    replacement  = sys.env("DAYNOMY_ENVIRONMENT")
  }

  rule {
    target_label = "service"
    replacement  = "postgres"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("DAYNOMY_INSTANCE")
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.remote_write.central.receiver]
  job_name        = "node"
  scrape_interval = "15s"
}

prometheus.scrape "database" {
  targets         = discovery.relabel.database.output
  forward_to      = [prometheus.remote_write.central.receiver]
  job_name        = "postgres"
  scrape_interval = "15s"
}

prometheus.remote_write "central" {
  endpoint {
    url            = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
    remote_timeout = "10s"
  }

  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}
