    {
      "type": "text",
      "x": 0,
      "y": 26,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## HTTP 요청",
        "background": "transparent"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 27,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "초당 요청 수",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "period": 60,
        "metrics": [
          [
            {
              "expression": "RATE(SUM(SEARCH('Namespace=\"DAYNOMY/Application\" environment=\"dev\" MetricName=\"http_server_requests_seconds_count\"', 'Average', 60)))",
              "id": "request_rate",
              "label": "요청/초"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 27,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "초당 5xx 수",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "period": 60,
        "metrics": [
          [
            {
              "expression": "RATE(SUM(SEARCH('Namespace=\"DAYNOMY/Application\" environment=\"dev\" outcome=\"SERVER_ERROR\" MetricName=\"http_server_requests_seconds_count\"', 'Average', 60)))",
              "id": "server_error_rate",
              "label": "5xx/초"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 27,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "평균 응답시간(초)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "period": 60,
        "metrics": [
          [
            {
              "expression": "RATE(SUM(SEARCH('Namespace=\"DAYNOMY/Application\" environment=\"dev\" MetricName=\"http_server_requests_seconds_sum\"', 'Average', 60))) / RATE(SUM(SEARCH('Namespace=\"DAYNOMY/Application\" environment=\"dev\" MetricName=\"http_server_requests_seconds_count\"', 'Average', 60)))",
              "id": "average_latency",
              "label": "평균 응답시간"
            }
          ]
        ]
      }
