      "properties": {
        "markdown": "## JVM",
        "background": "transparent"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 20,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "JVM Heap 사용률(%)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "period": 60,
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100
          }
        },
        "metrics": [
          [
            {
              "expression": "100 * SUM(SEARCH('Namespace=\"DAYNOMY/Application\" environment=\"dev\" area=\"heap\" MetricName=\"jvm_memory_used_bytes\"', 'Average', 60)) / SUM(SEARCH('Namespace=\"DAYNOMY/Application\" environment=\"dev\" area=\"heap\" MetricName=\"jvm_memory_max_bytes\"', 'Average', 60))",
              "id": "jvm_heap",
              "label": "Heap 사용률"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 20,
      "width": 8,
      "height": 6,
      "properties": {
