        "view": "timeSeries",
        "period": 60,
        "metrics": [
          [
            {
              "expression": "SUM(SEARCH('Namespace=\"DAYNOMY/Application\" environment=\"dev\" MetricName=\"jvm_threads_live_threads\"', 'Average', 60))",
