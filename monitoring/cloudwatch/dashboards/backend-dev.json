    {
      "type": "text",
      "x": 0,
      "y": 40,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 애플리케이션 로그",
        "background": "transparent"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 41,
      "width": 24,
      "height": 8,
      "properties": {
        "query": "SOURCE logGroups(namePrefix: [\"/daynomy/dev/backend\"], class: \"STANDARD\") |\nfields jsonParse(@message) as journal\n| fields jsonParse(journal.body.MESSAGE) as app\n| display @timestamp, app.level as level, app.message as message, app.logger_name as logger\n| sort @timestamp desc\n| limit 50",
        "region": "ap-northeast-2",
        "view": "table",
        "title": "DEV 백엔드 로그"
      }
    }
  ]
}
