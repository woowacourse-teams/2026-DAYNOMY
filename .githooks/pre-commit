#!/usr/bin/env sh
set -eu

fail() {
  echo "[DAYNOMY hook] $1" >&2
  exit 1
}

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
case "$branch" in
  main|dev) fail "$branch 브랜치에는 직접 커밋할 수 없습니다." ;;
esac

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged_files" ] && exit 0

if ! command -v gitleaks >/dev/null 2>&1; then
  fail "Gitleaks가 설치되어 있지 않습니다. 'brew install gitleaks'로 설치해주세요."
fi

if ! git diff --cached --unified=0 --no-color --no-ext-diff \
  | sed -n '/^+[^+]/s/^+//p' \
  | gitleaks stdin --redact=100 --no-banner; then
  fail "스테이징된 변경에서 비밀값이 발견되었습니다."
fi

sensitive_files=$(printf '%s\n' "$staged_files" | grep -E '(^|/)(\.env|\.env\..*|.*\.(pem|key|p12|jks))$' | grep -vFx 'frontend/.env.example' || true)
[ -z "$sensitive_files" ] || fail "환경변수 또는 키 파일은 커밋할 수 없습니다."

if printf '%s\n' "$staged_files" | grep -qFx 'frontend/.env.example'; then
  example=$(git show ':frontend/.env.example') || fail "환경변수 예시를 확인할 수 없습니다."
  if printf '%s\n' "$example" | grep -Ev '^[[:space:]]*(#.*)?$|^[A-Z][A-Z0-9_]*=$|^VITE_API_BASE_URL=http://localhost:8080$|^SENTRY_ENVIRONMENT=local$' | grep -q .; then
    fail "환경변수 예시는 로컬 기본값 외의 실제 값을 포함할 수 없습니다."
  fi
fi

if git diff --cached --check; then
  :
else
  fail "공백 오류가 포함되어 있습니다."
fi

if git diff --cached --unified=0 --no-color | grep -E '^\+[^+]' | grep -Eq '(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9_]+|sk-[A-Za-z0-9]{20,})'; then
  fail "커밋할 변경에서 민감정보 형식이 발견되었습니다."
fi

if git diff --cached --unified=0 --no-color | grep -E '^\+[^+]' | grep -Eq '^\+<<<<<<<|^\+=======|^\+>>>>>>>'; then
  fail "충돌 마커를 제거한 뒤 커밋하세요."
fi

git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -n1 sh -c '
  path="$1"
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if [ "$size" -gt 10485760 ]; then
    echo "[DAYNOMY hook] 10MB 초과 파일: $path" >&2
    exit 1
  fi
' sh || exit 1

case "$(printf '%s\n' "$staged_files")" in
  *backend/*)
    (cd backend && ./gradlew spotlessCheck test) || fail "백엔드 Spotless 또는 테스트가 실패했습니다."
    ;;
esac

case "$(printf '%s\n' "$staged_files")" in
  *frontend/*)
    (cd frontend && npm run format:check && npm run lint && npm run typecheck) || fail "프론트엔드 포맷, 린트 또는 타입 검사가 실패했습니다."
    ;;
esac
